# =========================================================
# MONDRIAN CP:
# Municipality-bin CP only
# =========================================================
# - 5 municipality bins
# - evaluation on ALL municipalities
# - combined plots:
#   1. municipality
#   2. year
#   3. price
# =========================================================

library(ranger)
library(dplyr)
library(ggplot2)
library(scales)
library(patchwork)

# =========================================================
# Parameters
# =========================================================

cph_alpha <- 0.10
cph_n_rep <- 100

# =========================================================
# Data preparation
# =========================================================

cph_df <- CphHousingPrices %>%
  
  na.omit() %>%
  
  mutate(
    
    log_KOEBESUM =
      log(KONTANT_KOEBESUM),
    
    cph_salgsaar =
      as.integer(
        format(
          SALG_KVARTAL,
          "%Y"
        )
      ),
    
    ENH_BAD_KODE =
      as.factor(ENH_BAD_KODE),
    
    LANDSDEL_NAVN =
      as.factor(LANDSDEL_NAVN),
    
    KOMMUNE_NAVN =
      as.factor(KOMMUNE_NAVN)
  ) %>%
  
  select(
    -KONTANT_KOEBESUM,
    -SALG_KVARTAL
  )

# =========================================================
# Stratified split
# =========================================================

cph_make_split <- function(df) {
  
  df %>%
    
    group_by(cph_salgsaar) %>%
    
    mutate(
      
      cph_n = n(),
      
      cph_idx =
        sample.int(cph_n[1]),
      
      split = case_when(
        
        cph_idx <= round(0.6*cph_n)
        ~ "train",
        
        cph_idx <= round(0.8*cph_n)
        ~ "cal",
        
        TRUE
        ~ "test"
      )
    ) %>%
    
    ungroup()
}

# =========================================================
# Storage
# =========================================================

kommune_results <- list()

# =========================================================
# Main loop
# =========================================================

for(i in 1:cph_n_rep){
  
  cat("Replication:", i, "\n")
  
  # =====================================================
  # Split data
  # =====================================================
  
  cph_split <- cph_make_split(cph_df)
  
  cph_train <- cph_split %>%
    filter(split == "train") %>%
    select(-split,-cph_idx,-cph_n)
  
  cph_cal <- cph_split %>%
    filter(split == "cal") %>%
    select(-split,-cph_idx,-cph_n)
  
  cph_test <- cph_split %>%
    filter(split == "test") %>%
    select(-split,-cph_idx,-cph_n)
  
  # =====================================================
  # Random forest
  # =====================================================
  
  cph_rf <- ranger(
    
    formula =
      log_KOEBESUM ~ .,
    
    data = cph_train,
    
    num.trees = 500,
    
    num.threads =
      parallel::detectCores()-1,
    
    seed =
      sample(1:10000,1)
  )
  
  # =====================================================
  # Predictions
  # =====================================================
  
  cal_pred <-
    predict(
      cph_rf,
      data = cph_cal
    )$predictions
  
  test_pred <-
    predict(
      cph_rf,
      data = cph_test
    )$predictions
  
  # =====================================================
  # Residuals
  # =====================================================
  
  cph_cal$residual <-
    
    abs(
      cph_cal$log_KOEBESUM -
        cal_pred
    )
  
  # =====================================================
  # Municipality bins
  # =====================================================
  
  kommune_prices <-
    
    cph_cal %>%
    
    group_by(KOMMUNE_NAVN) %>%
    
    summarise(
      
      mean_price =
        mean(
          exp(log_KOEBESUM)
        ),
      
      .groups = "drop"
    )
  
  kommune_prices <-
    
    kommune_prices %>%
    
    mutate(
      
      kommune_bin =
        cut(
          
          mean_price,
          
          breaks =
            quantile(
              mean_price,
              probs =
                seq(
                  0,1,
                  length.out = 6
                ),
              na.rm = TRUE
            ),
          
          labels = c(
            "Very low",
            "Low",
            "Medium",
            "High",
            "Very high"
          ),
          
          include.lowest = TRUE
        )
    )
  
  # =====================================================
  # Attach bins
  # =====================================================
  
  cph_cal <-
    
    cph_cal %>%
    
    left_join(
      
      kommune_prices %>%
        select(
          KOMMUNE_NAVN,
          kommune_bin
        ),
      
      by = "KOMMUNE_NAVN"
    )
  
  cph_test <-
    
    cph_test %>%
    
    left_join(
      
      kommune_prices %>%
        select(
          KOMMUNE_NAVN,
          kommune_bin
        ),
      
      by = "KOMMUNE_NAVN"
    )
  
  # =====================================================
  # Mondrian quantiles
  # =====================================================
  
  kommune_qhat <-
    
    cph_cal %>%
    
    group_by(kommune_bin) %>%
    
    summarise(
      
      qhat =
        quantile(
          
          residual,
          
          probs =
            ceiling(
              (n()+1) *
                (1-cph_alpha)
            ) / n()
        ),
      
      .groups = "drop"
    )
  
  # =====================================================
  # Attach qhat
  # =====================================================
  
  cph_test_kommune <-
    
    cph_test %>%
    
    left_join(
      kommune_qhat,
      by = "kommune_bin"
    )
  
  # =====================================================
  # Results
  # =====================================================
  
  kommune_df <- data.frame(
    
    faktisk =
      exp(
        cph_test_kommune$log_KOEBESUM
      ),
    
    lower =
      exp(
        test_pred -
          cph_test_kommune$qhat
      ),
    
    upper =
      exp(
        test_pred +
          cph_test_kommune$qhat
      ),
    
    covered =
      cph_test_kommune$log_KOEBESUM >=
      (test_pred - cph_test_kommune$qhat) &
      
      cph_test_kommune$log_KOEBESUM <=
      (test_pred + cph_test_kommune$qhat),
    
    width =
      exp(test_pred + cph_test_kommune$qhat) -
      exp(test_pred - cph_test_kommune$qhat),
    
    KOMMUNE_NAVN =
      cph_test_kommune$KOMMUNE_NAVN,
    
    cph_salgsaar =
      cph_test_kommune$cph_salgsaar,
    
    replication = i
  )
  
  kommune_results[[i]] <- kommune_df
}

# =========================================================
# Merge results
# =========================================================

kommune_df_all <-
  bind_rows(
    kommune_results
  )

# =========================================================
# Relative width
# =========================================================

kommune_df_all <-
  
  kommune_df_all %>%
  
  mutate(
    rel_width =
      width / faktisk
  )

# =========================================================
# Price bins
# =========================================================

breaks_price <- quantile(
  
  kommune_df_all$faktisk / 1e6,
  
  probs =
    seq(
      0,1,
      length.out = 11
    ),
  
  na.rm = TRUE
)

kommune_df_all <-
  
  kommune_df_all %>%
  
  mutate(
    
    price_bin =
      cut(
        faktisk / 1e6,
        breaks = breaks_price,
        include.lowest = TRUE
      )
  )

# =========================================================
# 1. MUNICIPALITY PLOT
# =========================================================

coverage_area <-
  
  kommune_df_all %>%
  
  group_by(KOMMUNE_NAVN) %>%
  
  summarise(
    
    coverage =
      mean(covered),
    
    mean_width =
      mean(width),
    
    .groups = "drop"
  ) %>%
  
  arrange(
    desc(coverage)
  )

coverage_area$KOMMUNE_NAVN <-
  
  factor(
    coverage_area$KOMMUNE_NAVN,
    levels =
      coverage_area$KOMMUNE_NAVN
  )

scale_factor_area <-
  
  max(
    coverage_area$coverage
  ) /
  
  max(
    coverage_area$mean_width
  )

p_area <-
  
  ggplot() +
  
  geom_line(
    
    data = coverage_area,
    
    aes(
      x = KOMMUNE_NAVN,
      y = coverage,
      group = 1,
      color = "Coverage"
    ),
    
    linewidth = 0.8
  ) +
  
  geom_point(
    
    data = coverage_area,
    
    aes(
      x = KOMMUNE_NAVN,
      y = coverage,
      color = "Coverage"
    ),
    
    size = 2
  ) +
  
  geom_point(
    
    data = coverage_area,
    
    aes(
      x = KOMMUNE_NAVN,
      y =
        mean_width *
        scale_factor_area,
      
      color = "Interval width"
    ),
    
    size = 2
  ) +
  
  geom_hline(
    yintercept = 0.9,
    linetype = "dashed"
  ) +
  
  scale_color_manual(
    
    values = c(
      "Coverage" = "darkblue",
      "Interval width" =
        "darkgreen"
    )
  ) +
  
  scale_y_continuous(
    
    name = "Coverage",
    
    limits = c(0,1),
    
    sec.axis = sec_axis(
      
      transform =
        ~ . / scale_factor_area,
      
      name =
        "Mean width (million DKK)",
      
      labels =
        label_number(
          scale = 1e-6
        )
    )
  ) +
  
  coord_flip() +
  
  labs(
    title =
      "Mondrian CP: coverage and width by municipality",
    
    x = NULL,
    
    color = NULL
  ) +
  
  theme_minimal()

