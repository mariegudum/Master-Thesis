# =====================================================
# MUNICIPALITY PLOT
# =====================================================

coverage_area <-
  
  kommune_only %>%
  
  group_by(KOMMUNE_NAVN) %>%
  
  summarise(
    coverage = mean(covered),
    mean_width = mean(width),
    .groups = "drop"
  ) %>%
  
  arrange(desc(coverage))

coverage_area$KOMMUNE_NAVN <-
  
  factor(
    coverage_area$KOMMUNE_NAVN,
    levels = coverage_area$KOMMUNE_NAVN
  )

scale_factor_area <-
  
  max(coverage_area$coverage) /
