# =====================================================
# Libraries
# =====================================================

library(dplyr)
library(ggplot2)
library(patchwork)
library(scales)

# =====================================================
# Coverage + width by kommune bin
# =====================================================

coverage_kommune_bin <-
  
  all_cp_results %>%
  
  filter(!is.na(kommune_bin)) %>%
  
  group_by(kommune_bin) %>%
  
  summarise(
    coverage = mean(covered),
    mean_width = mean(width),
    .groups = "drop"
  ) %>%
  
  arrange(desc(coverage))

coverage_kommune_bin$kommune_bin <-
  
  factor(
    coverage_kommune_bin$kommune_bin,
    levels = coverage_kommune_bin$kommune_bin
  )

scale_factor_kommune <-
  max(coverage_kommune_bin$coverage) /
  max(coverage_kommune_bin$mean_width)

p_mondrian_kommune <-
  
  ggplot() +
  
  # -------------------------------------------------
  # Coverage
  # -------------------------------------------------
  
  geom_line(
    data = coverage_kommune_bin,
    
    aes(
      x = kommune_bin,
      y = coverage,
      group = 1,
      color = "Coverage"
    ),
    
    linewidth = 0.8
  ) +
  
  geom_point(
    data = coverage_kommune_bin,
    
    aes(
      x = kommune_bin,
      y = coverage,
      color = "Coverage"
    ),
    
    size = 2
  ) +
  
  geom_hline(
    yintercept = 0.9,
    linetype = "dashed"
  ) +
  
  # -------------------------------------------------
  # Width
  # -------------------------------------------------
  
  geom_point(
    data = coverage_kommune_bin,
    
    aes(
      x = kommune_bin,
      y = mean_width * scale_factor_kommune,
      color = "Interval width"
    ),
    
    size = 2
  ) +
  
  scale_color_manual(
    values = c(
      "Coverage" = "darkblue",
      "Interval width" = "darkgreen"
    )
  ) +
  
  scale_y_continuous(
    
    name = "Coverage",
    
    limits = c(0,1),
    
    sec.axis = sec_axis(
      
      transform = ~ . / scale_factor_kommune,
      
      name = "Mean width (million DKK)",
      
      labels = label_number(scale = 1e-6)
    )
  ) +
  
  coord_flip() +
  
  labs(
    title = "Mondrian CP: kommune bins",
    x = NULL,
    color = NULL
  ) +
  
  theme_minimal()

