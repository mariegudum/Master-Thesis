# =========================================================
# Coverage + width by municipality
# =========================================================

coverage_area_cp <-
  
  all_results_cp %>%
  
  group_by(KOMMUNE_NAVN) %>%
  
  summarise(
    coverage = mean(covered),
    mean_width = mean(width),
    n = n(),
    .groups = "drop"
  ) %>%
  
  filter(n > 50) %>%
  
  arrange(desc(coverage)) %>%
  
  mutate(
    
    KOMMUNE_NAVN =
      factor(
        KOMMUNE_NAVN,
        levels = KOMMUNE_NAVN
      )
  )

scale_factor_area_cp <-
  max(coverage_area_cp$coverage) /
