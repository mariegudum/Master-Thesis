# =========================================================
# Libraries
# =========================================================

library(dplyr)
library(ggplot2)
library(scales)

# =========================================================
# Price bins
# =========================================================

breaks_price <- quantile(
  all_results_cp$faktisk / 1e6,
  probs = seq(0,1,length.out = 11),
  na.rm = TRUE
)

all_results_cp <-
  
  all_results_cp %>%
  
  mutate(
    
    price_bin = cut(
      faktisk / 1e6,
      breaks = breaks_price,
      include.lowest = TRUE
    )
  )

# =========================================================
# Coverage + width by year
# =========================================================

coverage_year_cp <-
  
  all_results_cp %>%
  
  group_by(cph_salgsaar) %>%
  
  summarise(
    coverage = mean(covered),
    mean_width = mean(width),
    .groups = "drop"
  )

scale_factor_year_cp <-
  max(coverage_year_cp$coverage) /
  max(coverage_year_cp$mean_width)

p_year_combined_cp <-
  
  ggplot() +
  
  # -------------------------------------------------
  # Coverage
  # -------------------------------------------------
  
  geom_line(
    data = coverage_year_cp,
    
    aes(
      x = cph_salgsaar,
      y = coverage,
      color = "Coverage"
    ),
    
    linewidth = 1
  ) +
  
  geom_point(
    data = coverage_year_cp,
    
    aes(
      x = cph_salgsaar,
      y = coverage,
      color = "Coverage"
    ),
    
    size = 2
  ) +
  
  geom_hline(
    yintercept = 0.9,
    color = "black",
    linetype = "dashed"
  ) +
  
  # -------------------------------------------------
  # Width
  # -------------------------------------------------
  
  geom_line(
    data = coverage_year_cp,
    
    aes(
      x = cph_salgsaar,
      y = mean_width * scale_factor_year_cp,
      color = "Interval width"
    ),
    
    linewidth = 1
  ) +
  
  geom_point(
    data = coverage_year_cp,
    
    aes(
      x = cph_salgsaar,
      y = mean_width * scale_factor_year_cp,
      color = "Interval width"
    ),
    
    size = 2
  ) +
  
  scale_color_manual(
    values = c(
      "Coverage" = "darkblue",
      "Interval width" = "darkgreen"
    )
  ) +
  
  scale_y_continuous(
    
    name = "Coverage",
    
    limits = c(0,1),
    
    sec.axis = sec_axis(
      
      transform = ~ . / scale_factor_year_cp,
      
      name = "Mean width (million DKK)",
      
      labels = label_number(scale = 1e-6)
    )
  ) +
  
  labs(
    title = "Split conformal prediction: coverage and width by year",
    x = "Sale year",
    color = NULL
  ) +
  
  theme_minimal() +
  
  theme(
    
    legend.position = "top",
    
    axis.title.y.left = element_text(
      color = "darkblue"
    ),
    
    axis.title.y.right = element_text(
      color = "darkgreen"
    ),
    
    axis.text.y.left = element_text(
      color = "darkblue"
    ),
    
    axis.text.y.right = element_text(
      color = "darkgreen"
    )
  )

p_year_combined_cp

